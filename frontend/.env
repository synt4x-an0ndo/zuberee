# =====================================================================
# Zuberee Fashion Frontend - API configuration
# =====================================================================
# Leave EMPTY when nginx serves the site and the backend from one host:
# the frontend then calls "/api/..." on the same origin (nginx proxies
# /api/, /storage/ and /uploads/ to the backend on 127.0.0.1:3001).
#
# Set an origin only - never include "/api":
#   NEXT_PUBLIC_API_BASE_URL=https://zuberee.com
#
# NEXT_PUBLIC_* is inlined by `next build`, so a change needs a rebuild.
NEXT_PUBLIC_API_BASE_URL=
