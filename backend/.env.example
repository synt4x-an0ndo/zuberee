# Copy this file to `.env` and replace the placeholders with real values.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
JWT_SECRET="change-me-to-a-long-random-secret"
FRONTEND_URL="http://localhost:3000"

# Optional SMTP config for password-reset emails.
# When unset, reset links are logged to the console (dev behaviour).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="you@example.com"
# SMTP_PASS="app-password"
# SMTP_FROM="Zuberee <no-reply@example.com>"
# SMTP_SECURE="false"