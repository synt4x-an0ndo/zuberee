generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRoleEnum {
  CUSTOMER
  ADMIN

  @@map("UserRole")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum SizeGuideType {
  NONE
  SHOE
  DRESS
}

model User {
  id                        Int            @id @default(autoincrement())
  name                      String
  email                     String         @unique
  passwordHash              String
  phone                     String?
  image                     String?
  emailVerificationRequired Boolean        @default(false)
  emailVerifiedAt           DateTime?
  badge                     String?
  role                      SystemRoleEnum @default(CUSTOMER)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  addresses           Address[]
  orders              Order[]
  cart                Cart?
  passwordResetTokens PasswordResetToken[]
  chatConversations   ChatConversation[]
  userRoles           UserRole[]

  @@map("users")
}

model Role {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  guardName String   @default("sanctum")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  guardName String   @default("sanctum")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId Int
  roleId Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

model Address {
  id          Int      @id @default(autoincrement())
  userId      Int
  fullName    String
  phone       String
  addressLine String
  city        String
  postalCode  String?
  country     String   @default("Bangladesh")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  slug        String  @unique
  description String?

  sizeGuideType SizeGuideType @default(NONE)

  parentId        Int?
  displayPriority Int     @default(0)
  stockTracking   Boolean @default(false)
  showOnHomepage  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("CategoryParent")

  products Product[]

  @@index([parentId])
  @@index([displayPriority])
  @@map("categories")
}

model Product {
  id               Int           @id @default(autoincrement())
  categoryId       Int
  name             String
  sku              String?       @unique
  description      String?
  shortDescription String?
  price            Decimal       @db.Decimal(10, 2)
  discount         Decimal?      @db.Decimal(10, 2)
  status           ProductStatus @default(IN_STOCK)
  videoUrl         String?
  stock            Int           @default(0)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images                ProductImage[]
  variants              ProductVariant[]
  colors                ProductColor[]
  specifications        ProductSpecification[]
  faqs                  ProductFaq[]
  inventory             ProductInventory?
  orderItems            OrderItem[]
  cartItem              CartItem[]
  productStockMovements ProductStockMovement[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

enum ProductStatus {
  IN_STOCK
  OUT_OF_STOCK
  PRE_ORDER
  SOLD_OUT
}

model ProductColor {
  id        Int      @id @default(autoincrement())
  productId Int
  name      String
  code      String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_colors")
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  colorId   Int?
  name      String
  value     String
  price     Decimal? @db.Decimal(10, 2)

  stock             Int     @default(0)
  held              Int     @default(0)
  reserved          Int     @default(0)
  lowStockThreshold Int?
  trackInventory    Boolean @default(false)
  allowPreorder     Boolean @default(false)
  preorderLimit     Int?
  preorderCount     Int     @default(0)
  isActive          Boolean @default(true)
  position          Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements StockMovement[]
  orderItems     OrderItem[]

  @@index([productId])
  @@index([colorId])
  @@map("product_variants")
}

model ProductSpecification {
  id        Int      @id @default(autoincrement())
  productId Int
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_specifications")
}

model ProductFaq {
  id        Int      @id @default(autoincrement())
  productId Int
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_faqs")
}

model ProductInventory {
  id             Int      @id @default(autoincrement())
  productId      Int      @unique
  trackInventory Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_inventory")
}

model AbandonedCheckout {
  id               Int       @id @default(autoincrement())
  sessionId        String?   @unique
  userId           Int?
  cartItems        Json
  name             String?
  phone            String?
  /// Only ever populated with a real value typed by the shopper - never inferred.
  email            String?
  address          String?
  /// District slug (matches lib/districts on the storefront); kept beside the
  /// free-text address so shipping can be requoted without parsing it back out.
  district         String?
  isRecovered      Boolean   @default(false)
  status           String    @default("pending")
  convertedOrderId Int?
  convertedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("abandoned_checkouts")
}

model ShippingCost {
  id              Int      @id @default(autoincrement())
  insideDhaka     Decimal  @default(80) @db.Decimal(10, 2)
  outsideDhaka    Decimal  @default(150) @db.Decimal(10, 2)
  oneShippingCost Decimal? @db.Decimal(10, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("shipping_costs")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  imageUrl  String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Order {
  id         Int     @id @default(autoincrement())
  userId     Int?
  guestName  String?
  guestPhone String?

  // Contact details supplied for this specific order. Guest fields above are
  // retained for existing customer aggregation; these snapshot fields are
  // populated for both guest and account orders.
  contactName   String?
  contactPhone  String?
  contactEmail  String?
  courierEntry  String?
  deliveryNotes String?

  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  totalAmount     Decimal       @db.Decimal(10, 2)
  shippingFee     Decimal       @default(0) @db.Decimal(10, 2)
  shippingAddress String
  district        String?
  advancePayment  Decimal       @default(0) @db.Decimal(10, 2)
  paymentMethod   String        @default("cash")
  assignedBadge   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([district])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id               Int      @id @default(autoincrement())
  orderId          Int
  productId        Int
  variantId        Int?
  size             String?
  quantity         Int
  unitPrice        Decimal  @db.Decimal(10, 2)
  // Snapshot of how this line was sold. preorderQuantity is the portion
  // not covered by physical stock when the order was placed; it returns
  // to zero when received stock is allocated for shipment/delivery.
  isPreorder       Boolean  @default(false)
  preorderQuantity Int      @default(0)
  // Inventory source selected when this line was allocated. This is a stable
  // historical snapshot so cancellations, reactivation and fulfilment do not
  // change behaviour if the product setting is later toggled.
  stockMode        String?  @db.VarChar(16)
  createdAt        DateTime @default(now())

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model Banner {
  id              Int      @id @default(autoincrement())
  image           Bytes
  imageType       String
  link            String?
  displayPriority Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([displayPriority])
  @@index([isActive])
  @@map("banners")
}

model Cart {
  id        Int      @id @default(autoincrement())
  userId    Int?     @unique
  sessionId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  productId Int
  variantId Int?
  colorId   Int?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId, colorId])
  @@index([cartId])
  @@map("cart_items")
}

model Size {
  id        Int      @id @default(autoincrement())
  size      String   @unique
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@map("sizes")
}

model FraudCheckerSettings {
  id           Int     @id @default(autoincrement())
  isActive     Boolean @default(true)
  cacheMinutes Int     @default(60)
  apiKey       String?
  providerUrl  String  @default("https://api.bdcourier.com/courier-check")

  planId        Int?
  planName      String?
  planType      String?
  isFree        Boolean   @default(true)
  status        String    @default("inactive")
  nextDueDate   DateTime?
  expiresAt     DateTime?
  daysRemaining Int       @default(0)
  frequency     String?
  price         Decimal?  @db.Decimal(10, 2)
  apiCalls      Int       @default(0)
  paidCalls     Int       @default(0)
  callLimit     Int       @default(0)
  paidLimit     Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fraud_checker_settings")
}

model AboutUs {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("about_us")
}

model FooterSettings {
  id                 Int      @id @default(autoincrement())
  logoPath           String?
  companyDescription String?
  companyAddress     String?
  companyEmail       String?
  companyPhone       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("footer_settings")
}

model SiteSettings {
  id                          Int      @id @default(autoincrement())
  siteName                    String   @default("Zuberee")
  faviconPath                 String?
  geminiApiKey                String?
  aiApiKey                    String?
  aiApiBaseUrl                String?
  aiApiModel                  String?
  faviconZoom                 Int      @default(85)
  logoSizes                   Json?
  primaryColor                String   @default("#092009")
  inventoryEnforcementEnabled Boolean  @default(false)
  lowStockThreshold           Int      @default(3)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@map("site_settings")
}

model SocialLinks {
  id             Int      @id @default(autoincrement())
  facebook       String?
  youtube        String?
  instagram      String?
  twitter        String?
  pinterest      String?
  facebookId     String?
  whatsappNumber String?
  messenger      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("social_links")
}

model FacebookSettings {
  id            Int      @id @default(autoincrement())
  pixelId       String?
  accessToken   String?
  testEventCode String?
  isActive      Boolean  @default(true)
  isTestMode    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("facebook_settings")
}

model ChatConversation {
  id        Int      @id @default(autoincrement())
  userId    Int
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([userId, status])
  @@index([updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  sender         String
  body           String
  readByAdmin    Boolean  @default(false)
  readByUser     Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model StockMovement {
  id               Int      @id @default(autoincrement())
  productVariantId Int
  type             String // "purchase" | "sale" | "reserve" | "release" | "adjustment"
  quantity         Int
  stockAfter       Int
  reservedAfter    Int
  note             String?
  userId           Int?
  orderId          Int?
  createdAt        DateTime @default(now())

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId])
  @@index([createdAt])
  @@map("stock_movements")
}

model ProductStockMovement {
  id         Int      @id @default(autoincrement())
  productId  Int
  type       String // "purchase" | "sale" | "release" | "adjustment"
  quantity   Int
  stockAfter Int
  note       String?
  userId     Int?
  orderId    Int?
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([orderId])
  @@index([createdAt])
  @@map("product_stock_movements")
}

/// Uploaded images live in Postgres (base64 text) and are served by
/// GET /api/media/:id. Next.js only serves files that were inside `public/`
/// when the production build ran, so runtime uploads written to disk 404 until
/// a rebuild/restart; keeping the bytes here lets a running server serve them.
model MediaAsset {
  id        String   @id @default(uuid())
  folder    String
  mimeType  String
  extension String
  byteSize  Int
  data      String   @db.Text
  createdAt DateTime @default(now())

  @@index([folder])
  @@index([createdAt])
  @@map("media_assets")
}